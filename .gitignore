# OS files
/.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
*.swp
*~

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
*.pid
*.seed
*.pid.lock

# Temporary files
/tmp
/.cache

# Docker
# Keep compose files tracked, but ignore local overrides and artifacts
docker-compose.override.yml
docker-compose.*.local.yml

# Ignore Docker build artifacts and local volumes (if created as folders)
sql-server-data/
*.tar
*.tar.gz

# Node (if added later)
node_modules/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/

# Environment and secrets
# Repository currently contains env/sqlserver.env for local dev. If you want
# to exclude it, add `env/sqlserver.env` here and add an example file instead.
.env
.env.local
env/*.local
env/*.secret
secrets/
*.pem
*.key

# Makefile generated artifacts
*.d

# Misc backups
*.bak
*.backup

# Local helpers
.gitignore.local
